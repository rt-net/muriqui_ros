<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="fsr_sensor_body" params="parent_link_name joint_name link_name *joint_origin">

    <joint name="${joint_name}" type="fixed">
      <parent link="${parent_link_name}" />
      <child link="${link_name}" />
      <xacro:insert_block name="joint_origin" />
    </joint>

    <link name="${link_name}">
      <visual>
        <geometry>
          <cylinder length="1.0e-4" radius="1.0e-2"/>
        </geometry>
        <material name="${COLOR_LINK_SENSORS}"/>
      </visual>

      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size= "1.0e-06 1.0e-06 1.0e-06" />
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0e-09"/>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <inertia ixx="1.0e-12" ixy="0.0" iyy="1.0e-12" ixz="0.0" iyz="0.0" izz="1.0e-12" />
      </inertial>
    </link>

  </xacro:macro>

</robot>