<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="muriqui_right_arm">

    <joint name="${NAME_JOINT_ARM_R_1}" type="revolute">
      <parent link="${NAME_LINK_BODY}" />
      <child link="${NAME_LINK_ARM_R_1}" />
      <origin xyz="0 -0.072 0.132" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_ARM_R_1_LOWER_LIMIT}" 
        upper="${JOINT_ARM_R_1_UPPER_LIMIT}" 
        effort="${XM430_W350_EFFORT_LIMIT}" 
        velocity="${XM430_W350_VELOCITY_LIMIT}"/>
      <axis xyz="0 -1 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_ARM_R_1}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_ARM_R_1}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_ARM}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 ${M_PI/2} 0" xyz="0.0 -0.026 -0.01"/>
        </simple_origin>
        <simple_geometry>
          <cylinder length="0.075" radius="0.03"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_ARM_R_1}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.065533"/>
        <origin xyz="-0.548e-03 -20.003e-03 -9.038e-03" rpy="0 0 0"/>
        <inertia ixx="30084.03e-09" ixy="-451.298e-09" iyy="51169.947e-09" ixz="-92.919e-09" iyz="-1578.236e-09" izz="54131.617e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_ARM_R_2}" type="revolute">
      <parent link="${NAME_LINK_ARM_R_1}" />
      <child link="${NAME_LINK_ARM_R_2_UPPER}" />
      <origin xyz="0 -0.031 -0.0105" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_ARM_R_2_LOWER_LIMIT}" 
        upper="${JOINT_ARM_R_2_UPPER_LIMIT}" 
        effort="${XM430_W350_EFFORT_LIMIT}" 
        velocity="${XM430_W350_VELOCITY_LIMIT}"/>
      <axis xyz="-1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_ARM_R_2_UPPER}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_ARM_R_2_UPPER}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_ARM}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="-0.008 -0.035 0.005"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.063 0.069 0.045"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_ARM_R_2_UPPER}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.243829"/>
        <origin xyz="-5.778e-03 -32.086e-03 2.710e-03" rpy="0 0 0"/>
        <inertia ixx="192607.547e-09" ixy="-30345.596e-09" iyy="94335.769e-09" ixz="1370.127e-09" iyz="431.165e-09" izz="228009.495e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_ARM_R_ADD4}" type="revolute">
      <parent link="${NAME_LINK_ARM_R_2_UPPER}" />
      <child link="${NAME_LINK_ARM_R_2_LOWER}" />
      <origin xyz="0 -0.0713 0" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_ARM_R_ADD4_LOWER_LIMIT}"
        upper="${JOINT_ARM_R_ADD4_UPPER_LIMIT}" 
        effort="${XM430_W350_EFFORT_LIMIT}" 
        velocity="${XM430_W350_VELOCITY_LIMIT}"/>
      <axis xyz="0 -1 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_ARM_R_2_LOWER}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_ARM_R_2_LOWER}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_ARM}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="0.0 -0.026 0.005"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.047 0.053 0.04"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_ARM_R_2_LOWER}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.124867"/>
        <origin xyz="0.638e-03 -36.610e-03 2.889e-03" rpy="0 0 0"/>
        <inertia ixx="58646.383e-09" ixy="378.358e-09" iyy="33190.998e-09" ixz="230.031e-09" iyz="-3282.962e-09" izz="63817.977e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_ARM_R_3}" type="revolute">
      <parent link="${NAME_LINK_ARM_R_2_LOWER}" />
      <child link="${NAME_LINK_ARM_R_3}" />
      <origin xyz="0 -0.0532 0" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_ARM_R_3_LOWER_LIMIT}"
        upper="${JOINT_ARM_R_3_UPPER_LIMIT}" 
        effort="${XM430_W350_EFFORT_LIMIT}" 
        velocity="${XM430_W350_VELOCITY_LIMIT}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_ARM_R_3}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_ARM_R_3}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_ARM}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="0.0 -0.095 0.01"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.055 0.15 0.02"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_ARM_R_3}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.146398"/>
        <origin xyz="0e-03 -80.904e-03 8.589e-03" rpy="0 0 0"/>
        <inertia ixx="386033.184e-09" ixy="-0.933e-09" iyy="62937.111e-09" ixz="-2.601e-09" iyz="-2546.382e-09" izz="422172.781e-09" />
      </inertial>
    </link>

  </xacro:macro>

</robot>
