      </joint>

      <joint name="${NAME_JOINT_LEG_L_6}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_6_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_6_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position">
