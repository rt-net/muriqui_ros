<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="muriqui_left_leg_ros2_control_settings">

    <ros2_control name="muriqui_left_leg" type="system">
      <xacro:unless value="${USE_LEFT_LEG_MOCK}">
        <hardware>
          <plugin>muriqui_hardware/MuriquiHardware</plugin>
          <param name="port_name">${LEFT_LEG_PORT_NAME}</param>
          <param name="manipulator_config_file_path">${LEFT_LEG_CONFIG_PATH}</param>
          <param name="baudrate">${BAUDRATE}</param>
          <param name="timeout_seconds">${TIMEOUT_SECONDS}</param>
        </hardware>
      </xacro:unless>

      <xacro:if value="${USE_LEFT_LEG_MOCK}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
      </xacro:if>

      <joint name="${NAME_JOINT_LEG_L_1}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_1_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_1_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <joint name="${NAME_JOINT_LEG_L_2}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_2_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_2_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <joint name="${NAME_JOINT_LEG_L_3}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_3_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_3_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <joint name="${NAME_JOINT_LEG_L_4}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_4_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_4_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <joint name="${NAME_JOINT_LEG_L_5}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_5_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_5_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <joint name="${NAME_JOINT_LEG_L_6}">
        <command_interface name="position">
          <param name="min">${JOINT_LEG_L_6_LOWER_LIMIT}"</param>
          <param name="max">${JOINT_LEG_L_6_UPPER_LIMIT}"</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="current_to_effort">2.41</param>
      </joint>

      <sensor name="left_fsr_sensor">
        <state_interface name="front_right"/>
        <state_interface name="front_left"/>
        <state_interface name="rear_left"/>
        <state_interface name="rear_right"/>
        <param name="front_joint">${NAME_JOINT_LEG_L_5}</param>
        <param name="rear_joint">${NAME_JOINT_LEG_L_6}</param>
      </sensor>

    </ros2_control>
  </xacro:macro>
</robot>