        <simple_geometry>
          <box size="0.05 0.07 0.15" />
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_4}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.153814"/>
        <origin xyz="4.588e-03 -0.084e-03 -53.245e-03" rpy="0 0 0"/>
        <inertia ixx="326296.935e-09" ixy="-59.31e-09" iyy="243945.619e-09" ixz="-17321.881e-09" iyz="28.06e-09" izz="126011.213e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_LEG_L_5}" type="revolute">
      <parent link="${NAME_LINK_LEG_L_4}" />
      <child link="${NAME_LINK_LEG_L_5}" />
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_LEG_L_5_LOWER_LIMIT}" 
        upper="${JOINT_LEG_L_5_UPPER_LIMIT}" 
        effort="${XM540_W270_EFFORT_LIMIT}" 
        velocity="${XM540_W270_VELOCITY_LIMIT}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_LEG_L_5}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_LEG_L_5}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_LEG}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="-0.037 0.0 0.015"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.08 0.035 0.06"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_5}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.394072"/>
        <origin xyz="-24.48e-03 0.436e-03 17.968e-03" rpy="0 0 0"/>
        <inertia ixx="188430.25e-09" ixy="-3779.002e-09" iyy="448453.994e-09" ixz="-1109.37e-09" iyz="679.892e-09" izz="380037.191e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_LEG_L_6}" type="revolute">
      <parent link="${NAME_LINK_LEG_L_5}" />
      <child link="${NAME_LINK_LEG_L_6}" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_LEG_L_6_LOWER_LIMIT}" 
        upper="${JOINT_LEG_L_6_UPPER_LIMIT}" 
        effort="${XM540_W270_EFFORT_LIMIT}" 
        velocity="${XM540_W270_VELOCITY_LIMIT}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_LEG_L_6}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_LEG_L_6}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_LEG}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="0.0 0.01 -0.033"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.13 0.08 0.02"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_6}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
