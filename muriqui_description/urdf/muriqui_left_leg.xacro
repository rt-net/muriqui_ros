        <material name="${COLOR_LINK_LEG}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 -0.058"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.04 0.07 0.15" />
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_3}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
