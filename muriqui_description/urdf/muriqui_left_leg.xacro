      <inertial>
        <mass value="0.146149"/>
        <origin xyz="1.821e-03 7.852e-03 -33.39e-03" rpy="0 0 0"/>
        <inertia ixx="93454.443e-09" ixy="-2514.113e-09" iyy="232511.492e-09" ixz="-6078.664e-09" iyz="4728.861e-09" izz="283877.014e-09" />
      </inertial>
    </link>

