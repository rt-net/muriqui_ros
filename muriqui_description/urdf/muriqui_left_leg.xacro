      <inertial>
        <mass value="0.281847"/>
        <origin xyz="0.64e-03 -0.307e-03 -83.084e-03" rpy="0 0 0"/>
        <inertia ixx="439725.571e-09" ixy="-267.456e-09" iyy="373877.804e-09" ixz="-609.803e-09" iyz="-5355.813e-09" izz="132967.974e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_LEG_L_4}" type="revolute">
      <parent link="${NAME_LINK_LEG_L_3}" />
      <child link="${NAME_LINK_LEG_L_4}" />
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_LEG_L_4_LOWER_LIMIT}" 
        upper="${JOINT_LEG_L_4_UPPER_LIMIT}" 
        effort="${XM540_W270_EFFORT_LIMIT}" 
        velocity="${XM540_W270_VELOCITY_LIMIT}"/>
      <axis xyz="0 -1 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
