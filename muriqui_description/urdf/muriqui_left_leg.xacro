<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="muriqui_left_leg">

    <joint name="${NAME_JOINT_LEG_L_1}" type="revolute">
      <parent link="${NAME_LINK_BODY}" />
      <child link="${NAME_LINK_LEG_L_1}" />
      <origin xyz="0 0.04 0" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_LEG_L_1_LOWER_LIMIT}" 
        upper="${JOINT_LEG_L_1_UPPER_LIMIT}" 
        effort="${XM540_W270_EFFORT_LIMIT}" 
        velocity="${XM540_W270_VELOCITY_LIMIT}"/>
      <axis xyz="0 0 -1"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_LEG_L_1}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_LEG_L_1}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_LEG}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="0.002 0.0 -0.025"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.06 0.03 0.05"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_1}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.047541"/>
        <origin xyz="5.375e-03 0e-03 -18.517e-03" rpy="0 0 0"/>
        <inertia ixx="16330.216e-09" ixy="0e-09" iyy="37997.481e-09" ixz="4518.986e-09" iyz="0e-09" izz="28358.113e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_LEG_L_2}" type="revolute">
      <parent link="${NAME_LINK_LEG_L_1}" />
      <child link="${NAME_LINK_LEG_L_2}" />
      <origin xyz="0 0 -0.041" rpy="0 0 0"/>
      <limit 
        lower="${JOINT_LEG_L_2_LOWER_LIMIT}" 
        upper="${JOINT_LEG_L_2_UPPER_LIMIT}" 
        effort="${XM540_W270_EFFORT_LIMIT}" 
        velocity="${XM540_W270_VELOCITY_LIMIT}"/>
      <axis xyz="-1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="${NAME_LINK_LEG_L_2}">
      <visual>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="${VISUAL_STL_FILE_PATH}/${NAME_LINK_LEG_L_2}.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${COLOR_LINK_LEG}"/>
      </visual>
      <xacro:generate_collision_tag>
        <simple_origin>
          <origin rpy="0 0 0" xyz="-0.025 0.0 -0.015"/>
        </simple_origin>
        <simple_geometry>
          <box size="0.11 0.045 0.06"/>
        </simple_geometry>
        <normal_origin>
          <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        </normal_origin>
        <normal_geometry>
          <mesh filename="${COLLISION_STL_FILE_PATH}/${NAME_LINK_LEG_L_2}.stl" scale="1.0 1.0 1.0"/>
        </normal_geometry>
      </xacro:generate_collision_tag>
      <inertial>
        <mass value="0.394765"/>
        <origin xyz="-24.401e-03 -0.353e-03 -17.937e-03" rpy="0 0 0"/>
        <inertia ixx="188682.107e-09" ixy="3832.426e-09" iyy="450062.836e-09" ixz="553.834e-09" iyz="1105.222e-09" izz="381448.613e-09" />
      </inertial>
    </link>

    <joint name="${NAME_JOINT_LEG_L_3}" type="revolute">
