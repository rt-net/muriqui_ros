<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="muriqui_gazebo_sensors">

    <xacro:if value="${USE_GAZEBO_IMU}">
      <gazebo>
        <plugin filename="libignition-gazebo-imu-system.so"
          name="ignition::gazebo::systems::Imu">
        </plugin>
      </gazebo>

      <gazebo reference="${NAME_LINK_IMU}">
        <sensor name='imu_sensor' type='imu'>
          <update_rate>100.0</update_rate>
          <always_on>1</always_on>
          <topic>imu/data_raw</topic>
          <visualize>false</visualize>
          <ignition_frame_id>${NAME_LINK_IMU}</ignition_frame_id>
          <imu>
            <orientation_reference_frame>
              <localization>ENU</localization>
              <custom_rpy parent_frame='world'>0 0 0</custom_rpy>
            </orientation_reference_frame>
          </imu>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="${USE_GAZEBO_HEAD_CAMERA}">
      <gazebo>
        <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
      </gazebo>

      <gazebo reference="${NAME_HEAD_CAMERA_PREFIX}_color_optical_frame">
        <sensor name="${NAME_HEAD_CAMERA_PREFIX}" type="camera">
          <pose>0 0 0 ${radians(90)} ${radians(-90)} 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>${NAME_HEAD_CAMERA_PREFIX}/image_raw</topic>
          <ignition_frame_id>${NAME_HEAD_CAMERA_PREFIX}_color_optical_frame</ignition_frame_id>
          <camera name="${NAME_HEAD_CAMERA_PREFIX}">
            <xacro:property name="chest_camera_width" value="1280"/>
            <xacro:property name="chest_camera_height" value="720"/>
            <xacro:property name="chest_camera_hfov" value="${radians(150)}"/>
            <xacro:property name="chest_camera_focal_length" value="${chest_camera_width / (2 * tan(chest_camera_hfov / 2))}"/>
            <horizontal_fov>${chest_camera_hfov}</horizontal_fov>
            <image>
              <width>${chest_camera_width}</width>
              <height>${chest_camera_height}</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <lens>
              <intrinsics>
                <fx>${chest_camera_focal_length}</fx>
                <fy>${chest_camera_focal_length}</fy>
                <cx>${(chest_camera_width + 1) / 2}</cx>
                <cy>${(chest_camera_height + 1) / 2}</cy>
                <s>1.0</s>
              </intrinsics>
              <projection>
                <p_fx>${chest_camera_focal_length}</p_fx>
                <p_fy>${chest_camera_focal_length}</p_fy>
                <p_cx>${(chest_camera_width + 1) / 2}</p_cx>
                <p_cy>${(chest_camera_height + 1) / 2}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
            </lens>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
